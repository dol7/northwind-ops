# Credentials that .mcp.json expands with ${VAR}. NEVER commit real values.
#
# Claude Code does NOT read .env files. Give it the value in ONE of these ways:
#   1. Export it in the shell that launches Claude Code:
#        export GITHUB_TOKEN=github_pat_...
#   2. Or put it in your personal, gitignored .claude/settings.local.json
#      (use this if you start Claude Code from the VS Code extension, which may not
#      inherit your shell exports):
#        { "env": { "GITHUB_TOKEN": "github_pat_..." } }
#
# Use a fine-grained, read-only personal access token: what the server can do is
# whatever the token is allowed to do.
GITHUB_TOKEN=
